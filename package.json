    "build": "tsc && chmod 755 build/index.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "files": [
    "build"
  ],
  "keywords": [
    "roxi",
    "roxi-os",
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "web3",
    "ethereum"
  ],
  "author": "ROXI OS",
  "license": "MIT",
  "dependencies": {
    "fastmcp": "^4.22.4",
    "solc": "^0.8.30",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.13.17",
    "typescript": "^5.8.2"
  },
  "homepage": "https://roxi-os.si/docs/servers/solc-mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ROXI-OS-SI/solc-mcp.git"
  },
  "publishConfig": {
    "access": "public"
  }
