{
  "name": "@roxi-os/solc-mcp",
  "version": "1.0.0",
  "description": "ROXI OS Solidity compiler MCP server: compiles contracts with solc-js for agent-driven deployment.",
  "type": "module",
  "main": "./build/index.js",
  "bin": {
    "solc-mcp": "build/index.js"
  },
  "scripts": {
    "inspect": "pnpm dlx fastmcp inspect ./src/index.ts",
